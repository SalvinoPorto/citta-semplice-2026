# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm workspaces: unico node_modules alla root)
node_modules

# lockfile unico alla root: i workspace non ne hanno uno proprio
citta-semplice-*/package-lock.json
packages/*/package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.xcf
#CLAUDE.md
#/.claude/
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
#.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Added by code-review-graph
.code-review-graph/

# tooling locale
.serena/

.vscode/
.claude/

# client Prisma generato: si rigenera con `npm run db:generate -w @citta/db`
packages/db/generated
# Cartelle non piu' generate da nessuno script (lo schema vive ora in
# packages/db): tenute in blacklist per proteggere da un `npx prisma
# generate` lanciato per errore dentro office/portal invece che nel
# package @citta/db.
citta-semplice-office/generated
citta-semplice-portal/generated

# credenziali locali per gli script db:* di @citta/db (vedi packages/db/.env.example)
packages/db/.env

# Workspace di lavoro di superpowers (ledger, brief, report di review)
.superpowers/

# Dump con dati di test caricato da docker-compose (infra/postgres): 31 MB, fuori dal repo
db_demo.sql

# Segreti per docker compose (interpolati in docker-compose.yml)
/.env

# Configurazione di produzione compilata sul nodo manager (vedi infra/produzione/config.env.example)
infra/produzione/config.env
