# Configurazione NON segreta dello stack di produzione.
#   cp config.env.example config.env   (config.env è in .gitignore)
# Letta da scripts/deploy.sh e scripts/migra.sh. I segreti NON vanno qui: si
# creano con scripts/crea-segreti.sh.
#
# ATTENZIONE: le variabili opzionali che non usate vanno lasciate COMMENTATE.
# Una variabile presente ma vuota arriva al container come stringa vuota e
# scavalca i default del codice (es. URBI_ID_AOO = '1').

# --- Immagini --------------------------------------------------------------
REGISTRY=ghcr.io/salvinoporto
# VERSIONE si passa a riga di comando: VERSIONE=v1.2.0 scripts/deploy.sh

# --- Host pubblici ---------------------------------------------------------
PORTAL_HOST=istanze.comune.example.it
OFFICE_HOST=office.comune.example.it
# Reti da cui l'office è raggiungibile (LAN dell'ente, VPN). Separate da virgola.
OFFICE_RETI_AMMESSE=10.0.0.0/8

# --- Dimensionamento -------------------------------------------------------
PORTAL_REPLICHE=3
OFFICE_REPLICHE=2
# (PORTAL_REPLICHE + OFFICE_REPLICHE + 2) x DATABASE_POOL_MAX < max_connections - 20
DATABASE_POOL_MAX=10
#OVERLAY_MTU=1450

# --- Object storage (Garage, VIP keepalived nella VLAN dati) ---------------
S3_ENDPOINT=http://10.30.0.20:3900
S3_BUCKET=citta-allegati
S3_REGION=garage

# --- Sessione --------------------------------------------------------------
JWT_EXPIRATION_HOURS=2

# --- SSO dell'ente (portal) ------------------------------------------------
CIG_SSO_URL=https://www.comune.catania.it/sso/
#CIG_STYLESHEET=
#CIG_LOGO_URL=

# --- Protocollo Urbi SMART (password: segreto urbi_password) ---------------
#URBI_PRODUCT_NAME=
URBI_BASE_URL=
URBI_USERNAME=
#URBI_ID_AOO=
#URBI_TIPO_MEZZO=
#URBI_CLASSIFICAZIONE=
#URBI_REGISTRATORE=
#URBI_TIMEOUT_MS=
#URBI_BREAKER_SOGLIA=
#URBI_BREAKER_RAFFREDDAMENTO_MS=
#PROTOCOL_FALLBACK_PREFIX=

# --- PMPay / PagoPA (password: segreto pmpay_password) ---------------------
PMPAY_URL=https://secure.pmpay.it/pagoparest
PMPAY_USERNAME=
PMPAY_ENTE_ID=
#PMPAY_TIMEOUT_MS=
#PMPAY_URL_OK=
#PMPAY_URL_KO=
#PMPAY_URL_CANCEL=

# --- Nomi dei segreti Swarm ------------------------------------------------
# Default: citta_<nome>_v1. Per ruotarne uno, crearne la _v2 e scommentare.
#SEGRETO_DATABASE_URL=citta_database_url_v2
#SEGRETO_DATABASE_URL_MIGRAZIONI=citta_database_url_migrazioni_v2
#SEGRETO_S3_ACCESS_KEY_ID=citta_s3_access_key_id_v2
#SEGRETO_S3_SECRET_ACCESS_KEY=citta_s3_secret_access_key_v2
#SEGRETO_URBI_PASSWORD=citta_urbi_password_v2
#SEGRETO_PMPAY_PASSWORD=citta_pmpay_password_v2
#SEGRETO_PORTAL_NEXTAUTH_SECRET=citta_portal_nextauth_secret_v2
#SEGRETO_OFFICE_NEXTAUTH_SECRET=citta_office_nextauth_secret_v2
#SEGRETO_CRON_SECRET=citta_cron_secret_v2
#SEGRETO_CIG_SECRET_KEY=citta_cig_secret_key_v2
#SEGRETO_TLS_CERT=citta_tls_cert_v2
#SEGRETO_TLS_KEY=citta_tls_key_v2
