# Environment Variables for Città Semplice Application
NEXT_PUBLIC_BASE_PATH=

# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# JWT
JWT_EXPIRATION_HOURS=

# File Storage
# "local" = filesystem del processo: utilizzabile solo con UNA istanza in
# esecuzione. "s3" = object storage S3-compatibile (Garage on-premise):
# obbligatorio con piu' replica, altrimenti la replica che scrive non e' quella
# che serve il download.
STORAGE_DRIVER=local
# Solo con STORAGE_DRIVER=local. Default: /data/uploads
# ATTENZIONE: il default era /tmp/allegati, ora e' unificato con l'office.
UPLOAD_DIR=
MODULES_DIR=
# Solo con STORAGE_DRIVER=s3
S3_BUCKET=
# Endpoint di Garage on-premise, es. https://garage.interno:3900
S3_ENDPOINT=
# Con Garage deve coincidere con s3_region del suo garage.toml (default "garage"),
# altrimenti ogni richiesta fallisce con AuthorizationHeaderMalformed.
# Default: us-east-1
S3_REGION=
# Se vuote, l'SDK usa la catena di credenziali di default dell'ambiente
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true con Garage; e' gia' il default quando S3_ENDPOINT e' valorizzato
S3_FORCE_PATH_STYLE=
# Prefisso opzionale, per condividere un bucket fra ambienti
S3_PREFIX=

# Pool connessioni Postgres, per processo (default 10).
# max x numero_replica deve restare sotto max_connections di Postgres.
DATABASE_POOL_MAX=
# Attesa massima di una connessione libera; 0 = illimitata (default)
DATABASE_POOL_TIMEOUT_MS=

# Urbi SMART - Protocollo
URBI_BASE_URL=
URBI_USERNAME=
URBI_PASSWORD=
URBI_ID_AOO=
URBI_TIPO_MEZZO=
URBI_CLASSIFICAZIONE=
URBI_REGISTRATORE=
URBI_TIMEOUT_MS=
PROTOCOL_FALLBACK_PREFIX=
# Circuit breaker su Urbi: dopo N fallimenti consecutivi l'invio smette di
# tentare la protocollazione in linea e passa alla via differita (numero interno
# subito, rettifica dal cron) per il tempo di raffreddamento indicato.
# Evita che ogni invio paghi il timeout mentre il protocollo e' giu'.
# Lo stato vive in memoria di processo: con piu' replica ciascuna impara per se'.
URBI_BREAKER_SOGLIA=
URBI_BREAKER_RAFFREDDAMENTO_MS=

# PmPay — PagoPA
# Test:  https://service.pmpay.it/pagoparest
# Prod:  https://secure.pmpay.it/pagoparest
PMPAY_URL=
PMPAY_USERNAME=
PMPAY_PASSWORD=
PMPAY_ENTE_ID=
PMPAY_TIMEOUT_MS=
# URL di redirect dopo il pagamento online (lasciate vuote usano NEXTAUTH_URL/pagamento/ok|ko|annullato)
PMPAY_URL_OK=
PMPAY_URL_KO=
PMPAY_URL_CANCEL=

# Cron Jobs (enable/disable)
ENABLE_CRON_JOBS=

# CIG SSO — SPID/CIE (Comune di Catania)
CIG_SSO_URL=
CIG_SECRET_KEY=
CIG_STYLESHEET=
CIG_LOGO_URL=
