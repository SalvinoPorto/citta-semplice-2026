# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# JWT
JWT_EXPIRATION_HOURS=

# File Storage
# "local" = filesystem del processo: utilizzabile solo con UNA istanza in
# esecuzione. "s3" = object storage S3-compatibile (Garage on-premise):
# obbligatorio con piu' replica, altrimenti la replica che scrive non e' quella
# che serve il download.
STORAGE_DRIVER=local
# Solo con STORAGE_DRIVER=local. Default: /data/uploads
UPLOAD_DIR=
MODULES_DIR=
# Solo con STORAGE_DRIVER=s3
S3_BUCKET=
# Endpoint di Garage on-premise, es. https://garage.interno:3900
S3_ENDPOINT=
# Con Garage deve coincidere con s3_region del suo garage.toml (default "garage"),
# altrimenti ogni richiesta fallisce con AuthorizationHeaderMalformed.
# Default: us-east-1
S3_REGION=
# Se vuote, l'SDK usa la catena di credenziali di default dell'ambiente
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true con Garage; e' gia' il default quando S3_ENDPOINT e' valorizzato
S3_FORCE_PATH_STYLE=
# Prefisso opzionale, per condividere un bucket fra ambienti
S3_PREFIX=

# Pool connessioni Postgres, per processo (default 10).
# max x numero_replica deve restare sotto max_connections di Postgres.
DATABASE_POOL_MAX=
# Attesa massima di una connessione libera; 0 = illimitata (default)
DATABASE_POOL_TIMEOUT_MS=

# External Services — Urbi SMART (protocollazione)
# Endpoint base: https://{host}/{dir}/progs/main/xapirest.sto
URBI_BASE_URL=
URBI_USERNAME=
URBI_PASSWORD=
URBI_ID_AOO=
URBI_TIPO_MEZZO=
URBI_CLASSIFICAZIONE=
URBI_REGISTRATORE=
URBI_TIMEOUT_MS=
# Prefisso per numerazione interna di emergenza (fallback quando Urbi non risponde)
PROTOCOL_FALLBACK_PREFIX=

PMPAY_URL=
PMPAY_API_KEY=
PMPAY_ENTE_ID=

# Cron Jobs (enable/disable)
# I job NON girano in-process: vanno invocati da uno scheduler esterno (cron di
# sistema, systemd timer, CronJob) via HTTP con l'header x-cron-secret.
#   GET /api/cron/protocollazione  -> rettifica i protocolli interni con Urbi.
#                                     Da schedulare di frequente (es. ogni
#                                     minuto): e' il secondo tempo dell'invio,
#                                     che non contatta piu' Urbi in linea.
#                                     Parametro opzionale ?lotto=N (default 25).
#   GET /api/cron/payments         -> aggiorna lo stato dei pagamenti
#   GET /api/cron/statistics       -> statistiche giornaliere
ENABLE_CRON_JOBS=
CRON_SECRET=
